---
// Ft1 · mast-headed footer — wordmark + tagline band, a few links, and an
// honest colophon line. Shared across every page of the site.
import { siteName, tagline } from '../lib/site.js';

const year = new Date().getFullYear();
---

<footer class="foot">
	<a class="foot-brand" href="/">{siteName}</a>
	<p class="foot-tagline">{tagline}</p>
	<nav aria-label="Footer">
		<a href="/exams/">Exams</a>
		<a href="/pricing/">Pricing</a>
		<a href="/help/">Help</a>
		<a href="/legal/terms/">Terms</a>
		<a href="/legal/privacy/">Privacy</a>
	</nav>
	<p class="colophon">
		© {year} {siteName}. Pilot software: the live app serves a synthetic pilot
		exam for testing, and no published content pack exists yet. Nothing on this
		site is medical advice.
	</p>
</footer>
