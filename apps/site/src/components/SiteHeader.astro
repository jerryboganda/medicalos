---
// N5 · floating pill — sticky, blurred, one primary action. Shared across
// every page; the pill stays put during cross-document view transitions.
import { appUrl, siteName } from '../lib/site.js';

let { current } = Astro.props;

const links = [
	{ href: '/exams/', label: 'Exams' },
	{ href: '/pricing/', label: 'Pricing' },
	{ href: '/help/', label: 'Help' },
	{ href: '/download/', label: 'Download' }
];
---

<header class="site-header">
	<div class="pill">
		<a class="site-brand" href="/">
			<img src="/favicon.svg" alt="" width="28" height="28" />
			<span>{siteName}</span>
		</a>
		<nav class="site-nav" aria-label="Site">
			{
				links.map((link) => (
					<a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
						{link.label}
					</a>
				))
			}
		</nav>
		<a class="btn small" href={`${appUrl}/today`}>Open the app</a>
	</div>
</header>
