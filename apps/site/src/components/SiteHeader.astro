---
// N6 · newspaper masthead — issue line, centred wordmark, inline link row,
// double rule. Shared across every page of the site.
import { siteName, tagline } from '../lib/site.js';

let { current } = Astro.props;

const links = [
	{ href: '/exams/', label: 'Exams' },
	{ href: '/pricing/', label: 'Pricing' },
	{ href: '/help/', label: 'Help' },
	{ href: '/download/', label: 'Download' }
];
---

<header>
	<p class="mast-issue-line">
		<span>{tagline}</span>
		<span>Pilot · content in development</span>
	</p>
	<a class="mast-brand" href="/">{siteName}</a>
	<nav class="mast-nav" aria-label="Site">
		{
			links.map((link) => (
				<a
					href={link.href}
					aria-current={current === link.href ? 'page' : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>
