---
import Base from '../layouts/Base.astro';
---

<Base current="" title="Page not found" description="This page does not exist.">
	<section class="hero">
		<div class="hero-copy enter-stagger">
			<h1>Page not found</h1>
			<p class="prose">There is nothing at this address — and we will not pretend otherwise.</p>
			<div class="actions">
				<a class="btn primary" href="/">Back to the start</a>
				<a class="btn" href="/help/">Get help</a>
			</div>
		</div>
	</section>
</Base>
