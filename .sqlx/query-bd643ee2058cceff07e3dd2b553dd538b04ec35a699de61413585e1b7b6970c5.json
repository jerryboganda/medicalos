  "query": "SELECT ce.competition_id, ce.handle, ce.score, ce.total_time_ms, c.title\n           FROM competition_entries ce\n           JOIN competitions c ON c.id = ce.competition_id\n           WHERE ce.user_id = $1\n           ORDER BY ce.submitted_at DESC\n           LIMIT 1",
