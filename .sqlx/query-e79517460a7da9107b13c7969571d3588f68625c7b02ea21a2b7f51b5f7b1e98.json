  "query": "SELECT r.id, r.to_version, r.reason_code, r.explanation, r.automatic, r.undone\n           FROM plan_revisions r JOIN plans p ON p.id = r.plan_id\n           WHERE p.user_id = $1 AND p.plan_date = CURRENT_DATE\n           ORDER BY r.created_at",
