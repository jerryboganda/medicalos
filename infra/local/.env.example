# Local Orca Desktop staging env — copy to infra/local/.env and fill in.
# .env is gitignored; never commit real values.

# Pin to the SHA of the deploy you want (see docs/deployment/orca-desktop.md
# "Update & rollback"). `latest` tracks the last green main deploy.
IMAGE_TAG=latest

# Postgres password for the local stack (any strong string).
POSTGRES_PASSWORD=change-me

# API pack-signing key: >= 32 non-whitespace bytes or the API refuses to boot.
# Generate with: openssl rand -base64 48
PACK_SIGNING_KEY=change-me-generate-32-bytes-minimum-with-openssl-rand-base64-48

# The origin the API should advertise (the web container on :8081).
PUBLIC_API_BASE_URL=http://localhost:8081/api
PUBLIC_APP_URL=http://localhost:8081

# Optional: enables the admin console (/api/v1/admin/*). Generate:
# openssl rand -hex 24. In the browser, also set
# localStorage.setItem('mlos_admin', '<value>') — admin routes need a
# logged-in user session AND this token.
# ADMIN_TOKEN=

# Optional integrations — leave unset locally.
# OIDC_CREDENTIAL_KEY=
# OPENAI_API_KEY=
